{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StrategySignalEvent",
  "type": "object",
  "required": ["schema_version", "signal_id", "source", "strategy_id", "strategy_version", "context_id", "symbol", "intent", "price_ref", "market_seq", "signal_time", "expire_ms", "trade_params", "trace_id"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "signal_id": { "type": "string" },
    "source": { "type": "string" },
    "strategy_id": { "type": "string" },
    "strategy_version": { "type": "string" },
    "context_id": { "type": "string" },
    "symbol": { "type": "string" },
    "intent": { "enum": ["OPEN_LONG", "OPEN_SHORT", "CLOSE_LONG", "CLOSE_SHORT", "REVERSE_LONG", "REVERSE_SHORT"] },
    "price_ref": { "type": "string" },
    "market_seq": { "type": "integer" },
    "signal_time": { "type": "string" },
    "expire_ms": { "type": "integer" },
    "confidence": { "type": "string" },
    "reason": { "type": "string" },
    "trade_params": { "$ref": "trade-params-schema.json" },
    "data_dependencies": { "type": "object", "additionalProperties": { "type": "string" } },
    "trace_id": { "type": "string" }
  }
}
