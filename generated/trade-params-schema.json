{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradeParams",
  "type": "object",
  "required": ["entry", "exits", "sizing", "position_management", "execution_constraints"],
  "properties": {
    "entry": {
      "type": "object",
      "required": ["trigger", "price", "timing"],
      "properties": {
        "trigger": { "type": "object" },
        "price": { "type": "object" },
        "timing": { "type": "object" }
      }
    },
    "exits": {
      "type": "object",
      "required": ["stop_loss", "take_profit"],
      "properties": {
        "stop_loss": { "type": "object" },
        "take_profit": { "type": "object" },
        "trailing_stop": { "type": "object" },
        "time_stop": { "type": "object" }
      }
    },
    "sizing": { "type": "object", "required": ["mode"] },
    "margin": { "type": "object" },
    "position_management": { "type": "object" },
    "execution_constraints": { "type": "object" }
  }
}
